generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CategoriaUsuario {
  ESTUDANTE
  DOCENTE
  PESQUISADOR
  COMUNIDADE_EXTERNA
}

enum PapelUsuario {
  PARTICIPANTE
  AVALIADOR
  ORGANIZADOR
  ADMIN
}

enum TipoToken {
  CONFIRMACAO_EMAIL
  RECUPERACAO_SENHA
  CONVITE_ORGANIZADOR
}

// Seções administráveis do site, usadas para restringir o que um
// ORGANIZADOR pode acessar (ver acessoCompleto/secoesPermitidas em
// Usuario). Espelha 1:1 os itens de NavegacaoEdicao.jsx no frontend.
// Algumas seções (PROGRAMACAO, CREDENCIAMENTO, CERTIFICADOS,
// SUBMISSOES_*) ainda não têm rota backend própria — o valor já existe
// no enum pra evitar uma segunda migration quando essas telas forem
// implementadas (Postgres não remove valores de enum facilmente).
// ADMIN sempre tem acesso total e nunca consulta este enum; "Início"
// também fica de fora por ser sempre acessível a ADMIN/ORGANIZADOR.
enum SecaoAdmin {
  ATIVIDADES
  // PAGINA_EVENTO cobre hoje o subitem "Hero + Navbar" de Página do evento
  // (reaproveitado tal e qual — as outras dobras da página pública ganharam
  // seções próprias abaixo, cada uma com sua rota em .../pagina/*).
  PAGINA_EVENTO
  PAGINA_APRESENTACAO
  PAGINA_MODALIDADES
  PAGINA_AGENDA
  PAGINA_PUBLICACOES
  PAGINA_REALIZADORES
  PROGRAMACAO
  // Cadastro do catálogo de modalidades/áreas de submissão (antes de abrir
  // as inscrições) — distinto dos SUBMISSOES_* abaixo, que são sobre
  // processar trabalhos já enviados pelos participantes (fase 2).
  SUBMISSOES_MODALIDADES
  SUBMISSOES_RECEBIMENTO
  SUBMISSOES_AVALIACAO
  SUBMISSOES_RESULTADO
  SUBMISSOES_APRESENTACAO
  SUBMISSOES_PUBLICACAO
  INSCRICOES_GERAIS
  INSCRICOES_ATIVIDADES
  CREDENCIAMENTO
  CERTIFICADOS
  PARTICIPANTES
  CONFIGURACOES_EVENTO
  TIPOS_ATIVIDADE
  TIPOS_PARTICIPACAO
}

enum ModalidadeEdicao {
  ONLINE
  PRESENCIAL
  HIBRIDO
}

// Papel de uma pessoa dentro de uma área temática de submissão — mesma
// pessoa nunca ocupa os dois papéis ao mesmo tempo (se acontecer, vira duas
// linhas). Separa as duas seções públicas de sempre ("Coordenação" /
// "Convidadas e convidados especiais") sem precisar de duas tabelas.
enum PapelPessoaArea {
  COORDENACAO
  CONVIDADO
}

// Paleta curada de fundo para seções da página pública da edição (DESIGN.md)
// — --areia é proposital ficar de fora (DESIGN.md proíbe usá-la como faixa
// de seção) e --buzio também (é assinatura, não fundo).
enum CorSecao {
  PAPEL
  TINTA
  BARRO
  OCRE
  CERRADO
}

// Paleta pública completa (inclui --buzio, cor de assinatura, e --areia) —
// usada em campos de texto/ícone da Hero, onde --buzio precisa estar
// disponível como opção (é a cor padrão do próprio búzio). CorSecao (acima)
// fica reservado pra fundo de seção, que não pode usar --buzio nem --areia.
enum CorPublica {
  TINTA
  BARRO
  OCRE
  BUZIO
  AREIA
  PAPEL
  CERRADO
}

// Faixa lateral da Hero: cor sólida (corFaixaHero*), imagem enviada pelo
// gestor (imagemFaixaHero*) ou nenhuma (elemento oculto) — ver
// page.module.scss, .heroFaixa.
enum TipoFaixaHero {
  COR
  IMAGEM
  NENHUMA
}

// Fundo da navbar no estado "topo" (antes de rolar): transparente (deixa a
// Hero aparecer por trás, comportamento atual) ou cor sólida. O estado
// "rolado" não tem esse eixo — é sempre cor sólida (ver BarraNavegacao.jsx).
enum TipoFundoNav {
  TRANSPARENTE
  COR
}

model Usuario {
  id                  String            @id @default(uuid())
  nome                String
  email               String            @unique
  cpf                 String?           @unique
  instituicao         String?
  categoria           CategoriaUsuario?
  foto                String?
  senhaHash           String
  emailConfirmado     Boolean           @default(false)
  papeis              PapelUsuario[]    @default([PARTICIPANTE])
  // Só têm efeito para quem tem ORGANIZADOR em papeis — ADMIN sempre tem
  // acesso total (bypass hardcoded em autorizarSecao), independente destes
  // campos. acessoCompleto=true equivale ao comportamento antigo de
  // ORGANIZADOR (acesso a tudo); quando false, o acesso é restrito às
  // seções listadas em secoesPermitidas.
  acessoCompleto      Boolean           @default(false)
  secoesPermitidas    SecaoAdmin[]      @default([])
  aceiteTermosEm      DateTime?
  aceitePrivacidadeEm DateTime?
  ativo               Boolean           @default(true)
  anonimizadoEm       DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  tokens              TokenVerificacao[]
  refreshTokens       RefreshToken[]
  inscricoesEdicao    InscricaoEdicao[]
  inscricoesAtividade InscricaoAtividade[]

  @@map("usuarios")
}

model TokenVerificacao {
  id        String    @id @default(uuid())
  usuarioId String
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tipo      TipoToken
  token     String    @unique
  expiraEm  DateTime
  usadoEm   DateTime?
  createdAt DateTime  @default(now())

  @@map("tokens_verificacao")
}

model RefreshToken {
  id         String    @id @default(uuid())
  usuarioId  String
  usuario    Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiraEm   DateTime
  revogadoEm DateTime?
  createdAt  DateTime  @default(now())

  @@map("refresh_tokens")
}

model Edicao {
  id                   String            @id @default(uuid())
  numero               Int               @unique
  nome                 String
  descricao            String?
  dataInicio           DateTime?
  dataFim              DateTime?
  slug                 String?           @unique
  cargaHorariaTotal    Int?
  instagram            String?
  facebook             String?
  linksExtras          Json?
  modalidade           ModalidadeEdicao?
  local                String?
  pais                 String?
  estado               String?
  cidade               String?
  fusoHorario          String?           @default("America/Sao_Paulo")
  notificarAlteracoes  Boolean           @default(true)
  corFundoRealizadores CorSecao          @default(BARRO)
  // Liga/desliga a faixa lateral (definida em faixaHero*) nesta seção — mesmo
  // mecanismo de mostrarFaixaApresentacao/Modalidades/Agenda/Publicacoes
  // abaixo, ver FaixaLateral em PaginaInicialConteudo.jsx.
  mostrarFaixaRealizadores Boolean       @default(true)
  // Logo customizada da Hero, enviada pelo gestor em SVG. Guardada como texto
  // (não no GCS) porque precisa ser injetada inline no DOM para reaproveitar
  // o efeito de reveal mascarado (rolo de tinta) — uma URL consumida via
  // <img> não permitiria isso. logoSvgViewBox guarda o viewBox original do
  // arquivo enviado, usado para renderizar a arte proporcionalmente dentro
  // do quadro fixo 778x896 do componente Logo.
  logoSvg              String?
  logoSvgViewBox       String?
  // Mapa "--logo-cor-N" -> hex, extraído automaticamente do SVG enviado (ver
  // sanitizarSvgLogo.js) — os fill/stroke/stop-color originais do arquivo são
  // reescritos pra referenciar essas variáveis, permitindo que o gestor edite
  // cada cor depois sem precisar reenviar o arquivo (Logo.jsx aplica esse
  // mapa como custom properties inline).
  logoSvgCores         Json?
  // Cores da Hero, customizáveis por edição — fundo reusa a paleta de 5
  // tokens de CorSecao; texto e búzio usam a paleta pública completa
  // (CorPublica), já que o búzio precisa poder usar sua própria cor de
  // assinatura (--buzio). PAPEL como default de corFundoHero preserva a
  // aparência atual (a Hero hoje não define fundo próprio).
  corFundoHero         CorSecao          @default(PAPEL)
  // Opacidade (0-100) do fundo da Hero — mistura corFundoHero com o --papel
  // por trás via CSS color-mix() (ver .hero em page.module.scss). 100 =
  // opaco, aparência atual. Só se aplica quando fundoHeroTipo = COR.
  opacidadeFundoHero   Int               @default(100)
  // Fundo da Hero pode ser cor sólida (corFundoHero/opacidadeFundoHero acima,
  // compartilhados entre breakpoints) ou uma imagem — aí sim com um arquivo
  // por breakpoint (desktop/mobile), já que a Hero muda muito de proporção
  // entre os dois e uma imagem só distorceria ou cortaria mal num dos casos.
  // Reusa TipoFaixaHero (COR/IMAGEM/NENHUMA) por já existir — NENHUMA não é
  // oferecido na UI de fundo (fundo sempre precisa de algo).
  fundoHeroTipo          TipoFaixaHero   @default(COR)
  imagemFundoHeroDesktop String?
  imagemFundoHeroMobile  String?
  corTextoHero         CorPublica        @default(TINTA)
  corBuzioHero         CorPublica        @default(BUZIO)
  // Faixas decorativas encostadas nas laterais da Hero (ver page.module.scss,
  // .heroFaixa) — cor independente do fundo/texto/búzio. Configuráveis
  // separadamente pra desktop e mobile (o gestor pode, por exemplo, usar uma
  // imagem larga no desktop e só cor sólida no mobile, já que a faixa fica
  // bem mais estreita lá — ver --largura-faixa-hero em layout.module.scss).
  // Cada uma pode ser cor sólida (corFaixaHero*) ou imagem enviada pelo
  // gestor (imagemFaixaHero*, URL no GCS — imagem raster comum, ao contrário
  // da logo, então não precisa ser inline: repete verticalmente via CSS
  // background-repeat).
  faixaHeroTipoDesktop TipoFaixaHero     @default(COR)
  corFaixaHeroDesktop  CorPublica        @default(OCRE)
  imagemFaixaHeroDesktop String?
  // Largura em px — substitui o clamp() fluido que era fixo em código
  // (layout.module.scss) por um valor fixo escolhido pelo gestor. Também
  // usado pela BarraNavegacao (ajusta o próprio padding, ver
  // EdicaoExibidaContext.jsx) pra não ficar por baixo da faixa.
  larguraFaixaHeroDesktop Int             @default(96)
  faixaHeroTipoMobile  TipoFaixaHero     @default(COR)
  corFaixaHeroMobile   CorPublica        @default(OCRE)
  imagemFaixaHeroMobile String?
  larguraFaixaHeroMobile  Int             @default(40)
  // Liga/desliga a faixa lateral só na Hero — os campos acima continuam
  // sendo a definição compartilhada (estilo) usada por todas as seções;
  // NENHUMA em faixaHeroTipo* ainda é o "desligar em toda a página" (não
  // há estilo pra ninguém mostrar). Este campo é só o "mostrar aqui",
  // mesmo mecanismo de mostrarFaixaApresentacao/Modalidades/Agenda/
  // Publicacoes/Realizadores abaixo — a Hero era a única seção sem essa
  // independência.
  mostrarFaixaHero Boolean @default(true)
  // Cores da navbar pública, customizáveis por edição — dois estados (Topo:
  // antes de rolar; Rolado: depois de rolar, ou sempre nas rotas sem Hero).
  // Defaults reproduzem exatamente a aparência hoje hardcoded em
  // BarraNavegacao.module.scss. navMesmoEstilo, quando true, faz o estado
  // Rolado usar as cores do Topo (ver BarraNavegacao.jsx).
  fundoNavTopoTipo     TipoFundoNav      @default(TRANSPARENTE)
  corFundoNavTopo      CorSecao          @default(PAPEL)
  corTextoNavTopo      CorPublica        @default(TINTA)
  corIconeNavTopo      CorPublica        @default(TINTA)
  corBordaNavTopo      CorPublica        @default(TINTA)
  corFundoNavRolado    CorSecao          @default(CERRADO)
  corTextoNavRolado    CorPublica        @default(PAPEL)
  corIconeNavRolado    CorPublica        @default(BUZIO)
  corBordaNavRolado    CorPublica        @default(BUZIO)
  navMesmoEstilo       Boolean           @default(false)
  // Demais dobras da página pública, cada uma com sua própria rota no admin
  // (.../pagina/apresentacao, /modalidades, /agenda, /publicacoes). Mesmos 3
  // eixos independentes da Hero (corFundo+opacidadeFundo misturados via
  // color-mix, mais corTexto/corBuzio à parte — ver opacidadeFundoHero/
  // corTextoHero/corBuzioHero acima) — fundo reusa CorSecao (5 tokens),
  // texto/búzio reusam CorPublica (7 tokens). Agenda não tem título/corpo: o
  // conteúdo daquela seção já vem da API de atividades, só a aparência muda.
  tituloApresentacao        String?
  corpoApresentacao         String?
  corFundoApresentacao      CorSecao      @default(PAPEL)
  opacidadeFundoApresentacao Int          @default(100)
  corTextoApresentacao      CorPublica    @default(TINTA)
  corBuzioApresentacao      CorPublica    @default(BARRO)
  // Botões "Inscreva-se"/"Conheça o GPDES" desta seção (.inscricaoCta/
  // .gpdesCta) — par único de cor compartilhado pelos dois, igual ao botão
  // de Modalidades (corFundoBotaoCard*/corTextoBotaoCard* abaixo): o
  // secundário vira uma versão em contorno da mesma cor do primário, em
  // vez de cada botão ter seu próprio eixo. Sem "Card" no nome porque,
  // diferente de Modalidades, esses botões não ficam dentro de um card.
  corFundoBotaoApresentacao CorPublica    @default(BARRO)
  corTextoBotaoApresentacao CorPublica    @default(PAPEL)
  tituloModalidades         String?
  corpoModalidades          String?
  corFundoModalidades       CorSecao      @default(PAPEL)
  opacidadeFundoModalidades Int           @default(100)
  corTextoModalidades       CorPublica    @default(TINTA)
  corBuzioModalidades       CorPublica    @default(BUZIO)
  // Cor dos cards dentro de Modalidades/Agenda (.modalidadeCartao/
  // CardAtividadeProgramacao) — eixo à parte da seção em volta. Defaults
  // reproduzem a aparência hardcoded de hoje (fundo color-mix(ocre 6%,
  // papel); título/resumo tinta; subtítulo/tipo agora explícito em vez de
  // herdar --texto-suave, que não é uma opção da paleta CorPublica; prazo/
  // meta barro; botão fundo barro + texto papel — antes o botão reusava a
  // mesma cor do prazo, o que deixava o botão invisível sempre que o
  // gestor escolhesse uma cor de destaque clara). Botão só existe em
  // Modalidades (.modalidadeCtaPrimario/.modalidadeLink) — o link de
  // Agenda (.detalhes) não tem preenchimento, então não corre o mesmo
  // risco e não ganha cor própria. Publicações não tem cards.
  corFundoCardModalidades           CorSecao   @default(OCRE)
  opacidadeFundoCardModalidades     Int        @default(6)
  corTextoCardModalidades           CorPublica @default(TINTA)
  corTextoSecundarioCardModalidades CorPublica @default(TINTA)
  corAcentoCardModalidades          CorPublica @default(BARRO)
  corFundoBotaoCardModalidades      CorPublica @default(BARRO)
  corTextoBotaoCardModalidades      CorPublica @default(PAPEL)
  corFundoAgenda            CorSecao      @default(PAPEL)
  opacidadeFundoAgenda      Int           @default(100)
  corTextoAgenda            CorPublica    @default(TINTA)
  corBuzioAgenda            CorPublica    @default(BUZIO)
  corFundoCardAgenda        CorSecao      @default(OCRE)
  opacidadeFundoCardAgenda  Int           @default(6)
  corTextoCardAgenda        CorPublica    @default(TINTA)
  corTextoSecundarioCardAgenda CorPublica @default(TINTA)
  corAcentoCardAgenda       CorPublica    @default(BARRO)
  tituloPublicacoes         String?
  corpoPublicacoes          String?
  corFundoPublicacoes       CorSecao      @default(PAPEL)
  opacidadeFundoPublicacoes Int           @default(100)
  corTextoPublicacoes       CorPublica    @default(TINTA)
  corBuzioPublicacoes       CorPublica    @default(BUZIO)
  // Faixa lateral (cor/imagem/largura definidas nos campos faixaHero* acima)
  // é renderizada por cada seção que a mantiver ligada (ver FaixaLateral em
  // PaginaInicialConteudo.jsx) — esses 4 campos só dizem se aquela seção
  // específica participa ou não. Default true preserva o comportamento atual
  // (faixa contínua em todas as seções).
  mostrarFaixaApresentacao Boolean       @default(true)
  mostrarFaixaModalidades  Boolean       @default(true)
  mostrarFaixaAgenda       Boolean       @default(true)
  mostrarFaixaPublicacoes  Boolean       @default(true)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  atividades           Atividade[]
  realizadores         EdicaoRealizador[]
  inscricoes           InscricaoEdicao[]
  modalidadesSubmissao ModalidadeSubmissao[]

  @@map("edicoes")
}

model Atividade {
  id              String        @id @default(uuid())
  edicaoId        String
  edicao          Edicao        @relation(fields: [edicaoId], references: [id], onDelete: Cascade)
  tipoAtividadeId String
  tipoAtividade   TipoAtividade @relation(fields: [tipoAtividadeId], references: [id])
  nome            String
  slug            String
  descricao       String?
  cargaHoraria    Int?
  local           String?
  exigeInscricao  Boolean       @default(true)
  semLimiteVagas  Boolean       @default(false)
  vagas           Int?
  inicioAtividade DateTime
  fimAtividade    DateTime
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  pessoas    AtividadePessoa[]
  inscricoes InscricaoAtividade[]

  @@unique([edicaoId, slug])
  @@map("atividades")
}

model TipoAtividade {
  id        String   @id @default(uuid())
  nome      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  atividades Atividade[]

  @@map("tipos_atividade")
}

model AtividadePessoa {
  id                 String            @id @default(uuid())
  atividadeId        String
  atividade          Atividade         @relation(fields: [atividadeId], references: [id], onDelete: Cascade)
  nome               String
  imagem             String?
  descricao          String?
  breveDescricao     String?
  tipoParticipacaoId String?
  tipoParticipacao   TipoParticipacao? @relation(fields: [tipoParticipacaoId], references: [id])
  ordem              Int               @default(0)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@map("atividade_pessoas")
}

model TipoParticipacao {
  id        String   @id @default(uuid())
  nome      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pessoas AtividadePessoa[]

  @@map("tipos_participacao")
}

model EdicaoRealizador {
  id        String   @id @default(uuid())
  edicaoId  String
  edicao    Edicao   @relation(fields: [edicaoId], references: [id], onDelete: Cascade)
  nome      String
  imagem    String
  link      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("edicao_realizadores")
}

// Modalidade de submissão de trabalhos (ex. "Conversatórios", "Narrativas
// Multimodais de Experiências") — por edição, cadastrada pelo gestor em
// Submissões → Modalidades. Substitui o catálogo antes fixo em
// frontend/lib/modalidadesSubmissao.js.
model ModalidadeSubmissao {
  id             String    @id @default(uuid())
  edicaoId       String
  edicao         Edicao    @relation(fields: [edicaoId], references: [id], onDelete: Cascade)
  slug           String
  nome           String
  subtitulo      String?
  prazoInicio    DateTime
  prazoFim       DateTime
  resumoCurto    String
  perguntaTitulo String
  descricao      String?
  linkRotulo     String    @default("Saiba mais")
  // Rótulo usado nas áreas desta modalidade, ex. "Conversatório" — a área N
  // é exibida publicamente como "{rotuloItem} N" (N deriva de AreaSubmissao.ordem).
  rotuloItem     String    @default("Área")
  ordem          Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  areas AreaSubmissao[]

  @@unique([edicaoId, slug])
  @@map("modalidades_submissao")
}

// Área temática dentro de uma modalidade (ex. os 15 Conversatórios de hoje)
// — nem toda modalidade tem áreas (lista pode ficar vazia).
model AreaSubmissao {
  id                    String              @id @default(uuid())
  modalidadeSubmissaoId String
  modalidadeSubmissao   ModalidadeSubmissao @relation(fields: [modalidadeSubmissaoId], references: [id], onDelete: Cascade)
  slug                  String
  titulo                String
  descricao             String?
  ordem                 Int                 @default(0)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  pessoas PessoaAreaSubmissao[]

  @@unique([modalidadeSubmissaoId, slug])
  @@map("areas_submissao")
}

// Coordenador(a) ou convidado(a) especial de uma área temática — mesmo
// modelo pros dois papéis (ver enum PapelPessoaArea), a página pública
// agrupa pelas duas seções de sempre.
model PessoaAreaSubmissao {
  id              String          @id @default(uuid())
  areaSubmissaoId String
  areaSubmissao   AreaSubmissao   @relation(fields: [areaSubmissaoId], references: [id], onDelete: Cascade)
  nome            String
  afiliacao       String?
  papel           PapelPessoaArea
  ordem           Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("pessoas_area_submissao")
}

enum StatusInscricaoAtividade {
  CONFIRMADA
  LISTA_ESPERA
}

// Inscrição geral no evento (edição) — independente de haver ou não
// atividades específicas com inscrição obrigatória. Uma por usuário por
// edição; o fluxo público de auto-inscrição cria uma única vez, mas permite
// voltar depois (reidentificação por CPF+e-mail) para adicionar inscrições
// em novas atividades — editar/cancelar a inscrição geral em si continua
// exigindo login (fora do escopo atual).
model InscricaoEdicao {
  id        String   @id @default(uuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  edicaoId  String
  edicao    Edicao   @relation(fields: [edicaoId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([usuarioId, edicaoId])
  @@map("inscricoes_edicao")
}

model InscricaoAtividade {
  id          String                   @id @default(uuid())
  usuarioId   String
  usuario     Usuario                  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  atividadeId String
  atividade   Atividade                @relation(fields: [atividadeId], references: [id], onDelete: Cascade)
  status      StatusInscricaoAtividade
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  // Cancelamento de inscrição fica fora do escopo atual; se for adicionado,
  // também será preciso decidir promoção automática de lista de espera.
  @@unique([usuarioId, atividadeId])
  @@index([atividadeId, status])
  @@map("inscricoes_atividade")
}

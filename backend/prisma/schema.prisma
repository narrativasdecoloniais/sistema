generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CategoriaUsuario {
  ESTUDANTE
  DOCENTE
  PESQUISADOR
  COMUNIDADE_EXTERNA
}

enum PapelUsuario {
  PARTICIPANTE
  AVALIADOR
  ORGANIZADOR
  ADMIN
}

enum TipoToken {
  CONFIRMACAO_EMAIL
  RECUPERACAO_SENHA
  CONVITE_ORGANIZADOR
  // Link mágico de identificação passwordless do fluxo público de submissão
  // de trabalho (ver submissoes.service.js) — não usa CPF, só e-mail.
  ENTRAR_SUBMISSAO
  // Código curto enviado pro e-mail de uma conta importada (sem CPF) pra
  // provar posse dela e vincular o CPF a ela no fluxo público de inscrição,
  // em vez de criar uma conta duplicada (ver inscricoes.service.js).
  VINCULAR_CONTA
  // Convite de avaliador de submissões para quem ainda não tem conta —
  // consumido no mesmo /definir-senha do convite de organizador.
  CONVITE_AVALIADOR
  // Código enviado para o novo endereço quando o próprio usuário troca o
  // e-mail no perfil — a troca só vale depois de digitado (ver
  // usuarios.service.js, solicitarTrocaEmail/confirmarTrocaEmail).
  ALTERAR_EMAIL
  // Autor principal sem conta de uma submissão inserida pela organização no
  // Recebimento — consumido no mesmo /definir-senha dos outros convites.
  CONVITE_AUTOR
}

// Seções administráveis do site, usadas para restringir o que um
// ORGANIZADOR pode acessar (ver acessoCompleto/secoesPermitidas em
// Usuario). Espelha 1:1 os itens de NavegacaoEdicao.jsx no frontend.
// Algumas seções (PROGRAMACAO, CREDENCIAMENTO, CERTIFICADOS,
// SUBMISSOES_*) ainda não têm rota backend própria — o valor já existe
// no enum pra evitar uma segunda migration quando essas telas forem
// implementadas (Postgres não remove valores de enum facilmente).
// ADMIN sempre tem acesso total e nunca consulta este enum; "Início"
// também fica de fora por ser sempre acessível a ADMIN/ORGANIZADOR.
enum SecaoAdmin {
  ATIVIDADES
  // PAGINA_EVENTO cobre hoje o subitem "Hero + Navbar" de Página do evento
  // (reaproveitado tal e qual — as outras dobras da página pública ganharam
  // seções próprias abaixo, cada uma com sua rota em .../pagina/*).
  PAGINA_EVENTO
  PAGINA_APRESENTACAO
  PAGINA_MODALIDADES
  PAGINA_AGENDA
  PAGINA_PUBLICACOES
  PAGINA_REALIZADORES
  PAGINA_APOIO
  PAGINA_CONTRIBUICAO
  PAGINA_LOCALIZACAO
  PAGINA_ATIVIDADES
  PROGRAMACAO
  // Cadastro do catálogo de modalidades/áreas de submissão (antes de abrir
  // as inscrições) — distinto dos SUBMISSOES_* abaixo, que são sobre
  // processar trabalhos já enviados pelos participantes (fase 2).
  SUBMISSOES_MODALIDADES
  SUBMISSOES_RECEBIMENTO
  SUBMISSOES_AVALIACAO
  SUBMISSOES_RESULTADO
  SUBMISSOES_APRESENTACAO
  SUBMISSOES_PUBLICACAO
  INSCRICOES_GERAIS
  INSCRICOES_ATIVIDADES
  CREDENCIAMENTO
  CERTIFICADOS
  PARTICIPANTES
  CONFIGURACOES_EVENTO
  TIPOS_ATIVIDADE
  TIPOS_PARTICIPACAO
  TIPOS_PONTO_INTERESSE
  PAGINA_COMISSOES
  GRUPOS_CONTEUDO
  // Inscrição e seleção de monitores (monitoria.service.js) — permite liberar
  // só a Coordenação de Monitoria.
  MONITORIA
}

// EM_ANALISE até a coordenação decidir; CANCELADA = desistência do candidato
// ou cancelamento pela coordenação (edital, item 8).
// Como o credenciamento/presença foi registrado: leitura do QR code pelo
// próprio participante ou pela equipe no admin (credenciamento.service.js).
enum OrigemCredenciamento {
  QR_CODE
  EQUIPE
}

enum StatusInscricaoMonitoria {
  EM_ANALISE
  SELECIONADO
  LISTA_ESPERA
  NAO_SELECIONADO
  CANCELADA
}

// Certificados (certificados.service.js): um modelo (fundo + texto + layout)
// por tipo e por edição; cada certificado emitido guarda um código público de
// validação e um snapshot dos valores dos marcadores.
enum TipoCertificado {
  PARTICIPACAO_EVENTO
  PRESENCA_ATIVIDADE
  APRESENTACAO_TRABALHO
  AVALIADOR
  MONITOR
}

enum OrigemCertificado {
  REGRA
  MANUAL
}

enum PosicaoQrCertificado {
  INFERIOR_DIREITO
  INFERIOR_ESQUERDO
  SUPERIOR_DIREITO
  SUPERIOR_ESQUERDO
}

enum AlinhamentoCertificado {
  ESQUERDA
  CENTRO
  DIREITA
  JUSTIFICADO
}

enum AlinhamentoVerticalCertificado {
  TOPO
  CENTRO
}

enum FonteCertificado {
  ARCHIVO
  TIMES
  HELVETICA
}

enum TipoAcaoContribuicao {
  NENHUMA
  LINK
  COPIAR
}

enum ModalidadeEdicao {
  ONLINE
  PRESENCIAL
  HIBRIDO
}

// Faixa lateral da Hero: cor sólida (corFaixaHero*), imagem enviada pelo
// gestor (imagemFaixaHero*) ou nenhuma (elemento oculto) — ver
// page.module.scss, .heroFaixa.
enum TipoFaixaHero {
  COR
  IMAGEM
  NENHUMA
}

// Fundo da navbar no estado "topo" (antes de rolar): transparente (deixa a
// Hero aparecer por trás, comportamento atual) ou cor sólida. O estado
// "rolado" não tem esse eixo — é sempre cor sólida (ver BarraNavegacao.jsx).
enum TipoFundoNav {
  TRANSPARENTE
  COR
}

model Usuario {
  id                   String            @id @default(uuid())
  nome                 String
  email                String            @unique
  cpf                  String?           @unique
  // Estrangeiro sem CPF: número de identificação do próprio país (sem
  // validação de formato — as regras variam por país), guardado normalizado
  // (maiúsculas, só letras e dígitos) e único no sistema todo. pais é o
  // código ISO 3166-1 alfa-2. Uma conta tem CPF ou documento, nunca os dois.
  documentoEstrangeiro String?           @unique
  pais                 String?
  instituicao          String?
  categoria            CategoriaUsuario?
  foto                 String?
  senhaHash            String
  emailConfirmado      Boolean           @default(false)
  papeis               PapelUsuario[]    @default([PARTICIPANTE])
  // Só têm efeito para quem tem ORGANIZADOR em papeis — ADMIN sempre tem
  // acesso total (bypass hardcoded em autorizarSecao), independente destes
  // campos. acessoCompleto=true equivale ao comportamento antigo de
  // ORGANIZADOR (acesso a tudo); quando false, o acesso é restrito às
  // seções listadas em secoesPermitidas.
  acessoCompleto       Boolean           @default(false)
  secoesPermitidas     SecaoAdmin[]      @default([])
  aceiteTermosEm       DateTime?
  aceitePrivacidadeEm  DateTime?
  ativo                Boolean           @default(true)
  anonimizadoEm        DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  tokens                     TokenVerificacao[]
  refreshTokens              RefreshToken[]
  inscricoesEdicao           InscricaoEdicao[]
  inscricoesAtividade        InscricaoAtividade[]
  inscricoesMonitoria        InscricaoMonitoria[]
  // Quem da equipe credenciou/registrou presença (credenciamento.service.js).
  credenciamentosRegistrados InscricaoEdicao[]        @relation("CredenciadoPor")
  presencasRegistradas       InscricaoAtividade[]     @relation("PresencaRegistradaPor")
  submissoes                 Submissao[]
  submissaoAutorias          SubmissaoAutor[]
  avaliacoesEdicao           AvaliadorEdicao[]
  certificados               Certificado[]
  comentariosAnais           ComentarioAnais[]
  convitesCoautor            ConviteCoautor[]
  enviosEmailCriados         EnvioEmail[]             @relation("EnvioEmailCriadoPor")
  enviosEmailRecebidos       EnvioEmailDestinatario[]

  @@map("usuarios")
}

model TokenVerificacao {
  id        String    @id @default(uuid())
  usuarioId String
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tipo      TipoToken
  token     String    @unique
  expiraEm  DateTime
  usadoEm   DateTime?
  createdAt DateTime  @default(now())

  @@map("tokens_verificacao")
}

model RefreshToken {
  id         String    @id @default(uuid())
  usuarioId  String
  usuario    Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiraEm   DateTime
  revogadoEm DateTime?
  createdAt  DateTime  @default(now())

  @@map("refresh_tokens")
}

model Edicao {
  id                                String               @id @default(uuid())
  numero                            Int                  @unique
  nome                              String
  descricao                         String?
  dataInicio                        DateTime?
  dataFim                           DateTime?
  // Janela de inscrições de participantes (self-service, área do
  // participante) — independente do período do evento em si (dataInicio/
  // dataFim). Sem os dois preenchidos, inscrições ficam fechadas por
  // padrão (nunca abrem "por acidente" numa edição sem essa configuração).
  inicioInscricoes                  DateTime?
  fimInscricoes                     DateTime?
  // AND-gate sobre a janela acima — nunca um OR. Marcar true só FECHA
  // inscrições antes do fim da janela; nunca abre fora dela. Para reabrir
  // antes do fim, o gestor desmarca; a data ainda manda se abre ou não
  // (ver backend/src/utils/inscricoesAbertas.js).
  inscricoesEncerradasManualmente   Boolean              @default(false)
  // Resultado das submissões (ver resultadoSubmissoes.service.js): divulgado
  // uma única vez por edição; o prazo vale para todas as correções pedidas
  // (APROVADO_COM_RESSALVAS e APROVADO_FORMATACAO).
  resultadoDivulgadoEm              DateTime?
  prazoCorrecaoSubmissao            DateTime?
  // Distribuição dos trabalhos nas atividades (apresentacaoSubmissoes.service.js)
  // só aparece na página pública da atividade e em Minhas submissões quando
  // publicada — nulo = oculta (pode voltar a ser ocultada).
  apresentacaoPublicadaEm           DateTime?
  // Monitoria (monitoria.service.js): janela de inscrição própria — mesma
  // regra de inscricoesAbertas.js, sem as duas datas fica fechada —, vagas
  // (só informativo, não bloqueia), catálogo de funções que o candidato
  // escolhe, edital em rich text (sanitizado como corpoContribuicao) e a
  // divulgação única do resultado.
  inicioInscricoesMonitoria         DateTime?
  fimInscricoesMonitoria            DateTime?
  vagasMonitoria                    Int?
  funcoesMonitoria                  String[]             @default([])
  editalMonitoria                   String?              @db.Text
  resultadoMonitoriaDivulgadoEm     DateTime?
  // Segredo do QR code de credenciamento geral (credenciamento.service.js):
  // gerado na primeira vez que o admin abre o QR; trocar invalida o impresso.
  tokenCredenciamento               String?              @unique
  slug                              String?              @unique
  cargaHorariaTotal                 Int?
  instagram                         String?
  facebook                          String?
  // E-mail de contato da organização — botão flutuante nas páginas públicas
  // (BotaoContatoFlutuante.jsx) e rodapé (Footer.jsx).
  emailContato                      String?
  linksExtras                       Json?
  modalidade                        ModalidadeEdicao?
  local                             String?
  pais                              String?
  estado                            String?
  cidade                            String?
  fusoHorario                       String?              @default("America/Sao_Paulo")
  notificarAlteracoes               Boolean              @default(true)
  // Cor de fundo/texto/ícone/búzio/borda em toda a página pública da edição:
  // String livre, não enum — aceita um token da paleta curada (ex. "BARRO")
  // ou um hex literal (ex. "#3366CC") escolhido livremente no seletor
  // "Personalizada" do admin (ver CampoCorSecao.jsx/lib/cores.js no
  // frontend, corSchema em edicoes.validators.js no backend).
  corFundoRealizadores              String               @default("BARRO")
  // Opacidade (0-100) do fundo de Realizadores — mesmo mecanismo de
  // opacidadeFundoHero acima (mistura corFundoRealizadores com --papel via
  // CSS color-mix(), ver .realizadores em page.module.scss).
  opacidadeFundoRealizadores        Int                  @default(100)
  // Liga/desliga a faixa lateral (definida em faixaHero*) nesta seção — mesmo
  // mecanismo de mostrarFaixaApresentacao/Modalidades/Agenda/Publicacoes
  // abaixo, ver FaixaLateral em PaginaInicialConteudo.jsx.
  mostrarFaixaRealizadores          Boolean              @default(true)
  corFundoApoiadores                String               @default("BARRO")
  opacidadeFundoApoiadores          Int                  @default(100)
  mostrarFaixaApoiadores            Boolean              @default(true)
  // Logo customizada da Hero, enviada pelo gestor em SVG. Guardada como texto
  // (não no GCS) porque precisa ser injetada inline no DOM para reaproveitar
  // o efeito de reveal mascarado (rolo de tinta) — uma URL consumida via
  // <img> não permitiria isso. logoSvgViewBox guarda o viewBox original do
  // arquivo enviado, usado para renderizar a arte proporcionalmente dentro
  // do quadro fixo 778x896 do componente Logo.
  logoSvg                           String?
  logoSvgViewBox                    String?
  // Mapa "--logo-cor-N" -> hex, extraído automaticamente do SVG enviado (ver
  // sanitizarSvgLogo.js) — os fill/stroke/stop-color originais do arquivo são
  // reescritos pra referenciar essas variáveis, permitindo que o gestor edite
  // cada cor depois sem precisar reenviar o arquivo (Logo.jsx aplica esse
  // mapa como custom properties inline).
  logoSvgCores                      Json?
  // Cores da Hero, customizáveis por edição. PAPEL como default de
  // corFundoHero preserva a aparência atual (a Hero hoje não define fundo
  // próprio).
  corFundoHero                      String               @default("PAPEL")
  // Opacidade (0-100) do fundo da Hero — mistura corFundoHero com o --papel
  // por trás via CSS color-mix() (ver .hero em page.module.scss). 100 =
  // opaco, aparência atual. Só se aplica quando fundoHeroTipo = COR.
  opacidadeFundoHero                Int                  @default(100)
  // Fundo da Hero pode ser cor sólida (corFundoHero/opacidadeFundoHero acima,
  // compartilhados entre breakpoints) ou uma imagem — aí sim com um arquivo
  // por breakpoint (desktop/mobile), já que a Hero muda muito de proporção
  // entre os dois e uma imagem só distorceria ou cortaria mal num dos casos.
  // Reusa TipoFaixaHero (COR/IMAGEM/NENHUMA) por já existir — NENHUMA não é
  // oferecido na UI de fundo (fundo sempre precisa de algo).
  fundoHeroTipo                     TipoFaixaHero        @default(COR)
  imagemFundoHeroDesktop            String?
  imagemFundoHeroMobile             String?
  corTextoHero                      String               @default("TINTA")
  corBuzioHero                      String               @default("BUZIO")
  // Faixas decorativas encostadas nas laterais da Hero (ver page.module.scss,
  // .heroFaixa) — cor independente do fundo/texto/búzio. Configuráveis
  // separadamente pra desktop e mobile (o gestor pode, por exemplo, usar uma
  // imagem larga no desktop e só cor sólida no mobile, já que a faixa fica
  // bem mais estreita lá — ver --largura-faixa-hero em layout.module.scss).
  // Cada uma pode ser cor sólida (corFaixaHero*) ou imagem enviada pelo
  // gestor (imagemFaixaHero*, URL no GCS — imagem raster comum, ao contrário
  // da logo, então não precisa ser inline: repete verticalmente via CSS
  // background-repeat).
  faixaHeroTipoDesktop              TipoFaixaHero        @default(COR)
  corFaixaHeroDesktop               String               @default("OCRE")
  imagemFaixaHeroDesktop            String?
  // Largura em px — substitui o clamp() fluido que era fixo em código
  // (layout.module.scss) por um valor fixo escolhido pelo gestor. Também
  // usado pela BarraNavegacao (ajusta o próprio padding, ver
  // EdicaoExibidaContext.jsx) pra não ficar por baixo da faixa.
  larguraFaixaHeroDesktop           Int                  @default(96)
  faixaHeroTipoMobile               TipoFaixaHero        @default(COR)
  corFaixaHeroMobile                String               @default("OCRE")
  imagemFaixaHeroMobile             String?
  larguraFaixaHeroMobile            Int                  @default(40)
  // Liga/desliga a faixa lateral só na Hero — os campos acima continuam
  // sendo a definição compartilhada (estilo) usada por todas as seções;
  // NENHUMA em faixaHeroTipo* ainda é o "desligar em toda a página" (não
  // há estilo pra ninguém mostrar). Este campo é só o "mostrar aqui",
  // mesmo mecanismo de mostrarFaixaApresentacao/Modalidades/Agenda/
  // Publicacoes/Realizadores abaixo — a Hero era a única seção sem essa
  // independência.
  mostrarFaixaHero                  Boolean              @default(true)
  // Cores da navbar pública, customizáveis por edição — dois estados (Topo:
  // antes de rolar; Rolado: depois de rolar, ou sempre nas rotas sem Hero).
  // Defaults reproduzem exatamente a aparência hoje hardcoded em
  // BarraNavegacao.module.scss. navMesmoEstilo, quando true, faz o estado
  // Rolado usar as cores do Topo (ver BarraNavegacao.jsx).
  fundoNavTopoTipo                  TipoFundoNav         @default(TRANSPARENTE)
  corFundoNavTopo                   String               @default("PAPEL")
  corTextoNavTopo                   String               @default("TINTA")
  corIconeNavTopo                   String               @default("TINTA")
  corBordaNavTopo                   String               @default("TINTA")
  corFundoNavRolado                 String               @default("CERRADO")
  corTextoNavRolado                 String               @default("PAPEL")
  corIconeNavRolado                 String               @default("BUZIO")
  corBordaNavRolado                 String               @default("BUZIO")
  navMesmoEstilo                    Boolean              @default(false)
  // Cor das abas de âncora (.ancoraBotao — Submissão/Programação/Anais, ver
  // BarraNavegacao.jsx). Par único (não Topo/Rolado, diferente das cores
  // acima) — mesmo mecanismo de corFundoBotaoApresentacao/
  // corFundoBotaoCardModalidades. O hover é automático (opacity reduzido em
  // cima da própria cor escolhida, ver .ancoraBotao em
  // BarraNavegacao.module.scss), sem campo próprio no banco.
  corFundoBotaoNav                  String               @default("BARRO")
  corTextoBotaoNav                  String               @default("PAPEL")
  // Demais dobras da página pública, cada uma com sua própria rota no admin
  // (.../pagina/apresentacao, /modalidades, /agenda, /publicacoes). Mesmos 3
  // eixos independentes da Hero (corFundo+opacidadeFundo misturados via
  // color-mix, mais corTexto/corBuzio à parte — ver opacidadeFundoHero/
  // corTextoHero/corBuzioHero acima). Agenda não tem título/corpo: o
  // conteúdo daquela seção já vem da API de atividades, só a aparência muda.
  tituloApresentacao                String?
  corpoApresentacao                 String?
  corFundoApresentacao              String               @default("PAPEL")
  opacidadeFundoApresentacao        Int                  @default(100)
  corTextoApresentacao              String               @default("TINTA")
  corBuzioApresentacao              String               @default("BARRO")
  // Botões "Inscreva-se"/"Conheça o GPDES" desta seção (.inscricaoCta/
  // .gpdesCta) — par único de cor compartilhado pelos dois, igual ao botão
  // de Modalidades (corFundoBotaoCard*/corTextoBotaoCard* abaixo): o
  // secundário vira uma versão em contorno da mesma cor do primário, em
  // vez de cada botão ter seu próprio eixo. Sem "Card" no nome porque,
  // diferente de Modalidades, esses botões não ficam dentro de um card.
  corFundoBotaoApresentacao         String               @default("BARRO")
  corTextoBotaoApresentacao         String               @default("PAPEL")
  tituloModalidades                 String?
  corpoModalidades                  String?
  corFundoModalidades               String               @default("PAPEL")
  opacidadeFundoModalidades         Int                  @default(100)
  corTextoModalidades               String               @default("TINTA")
  corBuzioModalidades               String               @default("BUZIO")
  // Cor dos cards dentro de Modalidades/Agenda (.modalidadeCartao/
  // CardAtividadeProgramacao) — eixo à parte da seção em volta. Defaults
  // reproduzem a aparência hardcoded de hoje (fundo color-mix(ocre 6%,
  // papel); título/resumo tinta; subtítulo/tipo agora explícito em vez de
  // herdar --texto-suave, que não é uma opção da paleta curada; prazo/
  // meta barro; botão fundo barro + texto papel — antes o botão reusava a
  // mesma cor do prazo, o que deixava o botão invisível sempre que o
  // gestor escolhesse uma cor de destaque clara). Botão só existe em
  // Modalidades (.modalidadeCtaPrimario/.modalidadeLink) — o link de
  // Agenda (.detalhes) não tem preenchimento, então não corre o mesmo
  // risco e não ganha cor própria. Publicações não tem cards.
  corFundoCardModalidades           String               @default("OCRE")
  opacidadeFundoCardModalidades     Int                  @default(6)
  corTextoCardModalidades           String               @default("TINTA")
  corTextoSecundarioCardModalidades String               @default("TINTA")
  corAcentoCardModalidades          String               @default("BARRO")
  corFundoBotaoCardModalidades      String               @default("BARRO")
  corTextoBotaoCardModalidades      String               @default("PAPEL")
  corFundoAgenda                    String               @default("PAPEL")
  opacidadeFundoAgenda              Int                  @default(100)
  corTextoAgenda                    String               @default("TINTA")
  corBuzioAgenda                    String               @default("BUZIO")
  corFundoCardAgenda                String               @default("OCRE")
  opacidadeFundoCardAgenda          Int                  @default(6)
  corTextoCardAgenda                String               @default("TINTA")
  corTextoSecundarioCardAgenda      String               @default("TINTA")
  corAcentoCardAgenda               String               @default("BARRO")
  tituloPublicacoes                 String?
  corpoPublicacoes                  String?
  corFundoPublicacoes               String               @default("PAPEL")
  opacidadeFundoPublicacoes         Int                  @default(100)
  corTextoPublicacoes               String               @default("TINTA")
  corBuzioPublicacoes               String               @default("BUZIO")
  // Seção "Localização" (mapa + lista de pontos de interesse) — sem búzio
  // porque essa seção não usa o marcador Búzio (ver PaginaInicialConteudo.jsx).
  corFundoLocalizacao               String               @default("PAPEL")
  opacidadeFundoLocalizacao         Int                  @default(100)
  corTextoLocalizacao               String               @default("TINTA")
  // Seção "Comissões" (lista de cartões, um por comissão, ver Comissao
  // abaixo) — mesmo bloco de 7 campos de Publicações, com búzio, mais o
  // eixo de cor de card (abas + acordeão de GruposConteudoAbas.jsx, mesmo
  // padrão de corFundoCardModalidades/corFundoCardAgenda acima — defaults
  // reproduzem o visual hardcoded anterior: papel 100%, texto tinta,
  // destaque barro).
  tituloComissoes                   String?
  corpoComissoes                    String?
  corFundoComissoes                 String               @default("PAPEL")
  opacidadeFundoComissoes           Int                  @default(100)
  corTextoComissoes                 String               @default("TINTA")
  corBuzioComissoes                 String               @default("BUZIO")
  corFundoCardComissoes             String               @default("PAPEL")
  opacidadeFundoCardComissoes       Int                  @default(100)
  corTextoCardComissoes             String               @default("TINTA")
  corTextoSecundarioCardComissoes   String               @default("TINTA")
  corAcentoCardComissoes            String               @default("BARRO")
  // Faixa lateral (cor/imagem/largura definidas nos campos faixaHero* acima)
  // é renderizada por cada seção que a mantiver ligada (ver FaixaLateral em
  // PaginaInicialConteudo.jsx) — esses 6 campos só dizem se aquela seção
  // específica participa ou não. Default true preserva o comportamento atual
  // (faixa contínua em todas as seções).
  mostrarFaixaApresentacao          Boolean              @default(true)
  mostrarFaixaModalidades           Boolean              @default(true)
  mostrarFaixaAgenda                Boolean              @default(true)
  mostrarFaixaPublicacoes           Boolean              @default(true)
  mostrarFaixaLocalizacao           Boolean              @default(true)
  mostrarFaixaComissoes             Boolean              @default(true)
  // Aparência compartilhada por TODAS as páginas de detalhe de atividade
  // (.../atividades/[slug]) — não por atividade individual (uma tentativa
  // anterior de personalização por atividade foi revertida). Mesmos 3 eixos
  // independentes das demais dobras (corFundo+opacidadeFundo via color-mix,
  // corTexto/corBuzio à parte) — ver DetalheAtividade.jsx no público e
  // AparenciaAtividadesForm.jsx no admin (.../pagina/atividades).
  corFundoAtividades                String               @default("PAPEL")
  opacidadeFundoAtividades          Int                  @default(100)
  corTextoAtividades                String               @default("TINTA")
  corBuzioAtividades                String               @default("BARRO")
  mostrarFaixaAtividades            Boolean              @default(true)
  // Mensagem de contribuição voluntária (ex. pedido de doação via PIX) na
  // etapa final da inscrição pública — não é uma dobra da home, por isso
  // sem cor/opacidade/faixa como as acima. Só aparece no público quando
  // corpoContribuicao estiver preenchido; a ação extra (link ou valor pra
  // copiar) é mutuamente exclusiva, controlada por tipoAcaoContribuicao.
  tituloContribuicao                String?
  corpoContribuicao                 String?
  tipoAcaoContribuicao              TipoAcaoContribuicao @default(NENHUMA)
  linkContribuicaoUrl               String?
  linkContribuicaoRotulo            String?
  copiaContribuicaoValor            String?
  copiaContribuicaoRotulo           String?
  // QR code opcional pra acompanhar a chave PIX (tipoAcaoContribuicao ==
  // COPIAR) — mesmo tratamento de imagem raster escalar das faixas/fundo da
  // Hero (upload vira URL do GCS via processarImagemEscalar em
  // edicoes.service.js).
  qrCodeContribuicao                String?
  createdAt                         DateTime             @default(now())
  updatedAt                         DateTime             @updatedAt

  atividades            Atividade[]
  realizadores          EdicaoRealizador[]
  apoiadores            EdicaoApoiador[]
  pontosInteresse       EdicaoPontoInteresse[]
  inscricoes            InscricaoEdicao[]
  inscricoesMonitoria   InscricaoMonitoria[]
  modalidadesSubmissao  ModalidadeSubmissao[]
  submissoes            Submissao[]
  gruposConteudo        GrupoConteudo[]
  avaliadores           AvaliadorEdicao[]
  modelosEmailResultado ModeloEmailResultado[]
  modelosCertificado    ModeloCertificado[]
  certificados          Certificado[]
  anais                 AnaisEdicao?
  artigosAnais          ArtigoAnais[]
  enviosEmail           EnvioEmail[]

  @@map("edicoes")
}

model Atividade {
  id                     String         @id @default(uuid())
  edicaoId               String
  edicao                 Edicao         @relation(fields: [edicaoId], references: [id], onDelete: Cascade)
  tipoAtividadeId        String
  tipoAtividade          TipoAtividade  @relation(fields: [tipoAtividadeId], references: [id])
  nome                   String
  slug                   String
  descricao              String?
  cargaHoraria           Int?
  local                  String?
  exigeInscricao         Boolean        @default(true)
  semLimiteVagas         Boolean        @default(false)
  vagas                  Int?
  inicioAtividade        DateTime
  fimAtividade           DateTime
  atividadeContinua      Boolean        @default(false)
  // Segredo do QR code de presença (só atividades com exigeInscricao) — mesmo
  // esquema de Edicao.tokenCredenciamento.
  tokenPresenca          String?        @unique
  paraConvidados         Boolean        @default(false)
  paraCriancasConvidadas Boolean        @default(false)
  // Posição na programação entre atividades que começam no mesmo horário
  // (menor = aparece antes). Nulo = sem ordem definida: mantém a ordem
  // anterior à coluna (tipo, depois nome).
  ordem                  Int?
  areaSubmissaoId        String?
  areaSubmissao          AreaSubmissao? @relation(fields: [areaSubmissaoId], references: [id], onDelete: Restrict)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  pessoas               AtividadePessoa[]
  inscricoes            InscricaoAtividade[]
  trabalhosApresentados Submissao[]
  certificados          Certificado[]

  @@unique([edicaoId, slug])
  @@map("atividades")
}

// Motor genérico de conteúdo da dobra pública "Comissões e Programas" —
// substitui os antigos TipoComissao/Comissao/ComissaoMembro e
// ProgramaPosGraduacao (catálogo global), unificando os dois num único
// esquema de 3 níveis configurável pelo gestor: Grupo (ex. "Comissão
// Organizadora", "Programas de Pós-Graduação") -> Lista (ex. "1.1 Geral",
// "1.2 Executiva") -> Item (nome + imagem/link opcionais, cobre tanto um
// integrante de comissão quanto um programa com logo e link). Sempre por
// edição — Programas deixou de ser compartilhado entre edições.
model GrupoConteudo {
  id        String   @id @default(uuid())
  edicaoId  String
  edicao    Edicao   @relation(fields: [edicaoId], references: [id], onDelete: Cascade)
  nome      String
  ordem     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listas ListaConteudo[]

  @@map("grupos_conteudo")
}

model ListaConteudo {
  id              String        @id @default(uuid())
  grupoConteudoId String
  grupoConteudo   GrupoConteudo @relation(fields: [grupoConteudoId], references: [id], onDelete: Cascade)
  nome            String
  ordem           Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  itens ItemConteudo[]

  @@map("listas_conteudo")
}

model ItemConteudo {
  id              String        @id @default(uuid())
  listaConteudoId String
  listaConteudo   ListaConteudo @relation(fields: [listaConteudoId], references: [id], onDelete: Cascade)
  nome            String
  imagem          String?
  link            String?
  ordem           Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("itens_conteudo")
}

model TipoAtividade {
  id        String   @id @default(uuid())
  nome      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  atividades Atividade[]

  @@map("tipos_atividade")
}

model AtividadePessoa {
  id                 String            @id @default(uuid())
  atividadeId        String
  atividade          Atividade         @relation(fields: [atividadeId], references: [id], onDelete: Cascade)
  nome               String
  imagem             String?
  descricao          String?
  breveDescricao     String?
  tipoParticipacaoId String?
  tipoParticipacao   TipoParticipacao? @relation(fields: [tipoParticipacaoId], references: [id])
  ordem              Int               @default(0)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@map("atividade_pessoas")
}

// `ordem` é a preferência de renderização do tipo nas páginas públicas da
// atividade (menor = aparece antes). Opcional de propósito: nulo significa
// "sem ordem definida" e o tipo se comporta como antes da coluna existir
// (grupos na ordem de primeiro aparecimento entre as pessoas da atividade).
model TipoParticipacao {
  id        String   @id @default(uuid())
  nome      String   @unique
  ordem     Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pessoas AtividadePessoa[]

  @@map("tipos_participacao")
}

model EdicaoRealizador {
  id        String   @id @default(uuid())
  edicaoId  String
  edicao    Edicao   @relation(fields: [edicaoId], references: [id], onDelete: Cascade)
  nome      String
  imagem    String
  link      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("edicao_realizadores")
}

model EdicaoApoiador {
  id        String   @id @default(uuid())
  edicaoId  String
  edicao    Edicao   @relation(fields: [edicaoId], references: [id], onDelete: Cascade)
  nome      String
  imagem    String
  link      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("edicao_apoiadores")
}

// Catálogo global de tipos de ponto de referência (ex.: "Local do evento",
// "Hospedagem"), compartilhado entre todas as edições — mesmo espírito de
// TipoAtividade. Cor livre (hex), usada nos marcadores do mapa público.
model TipoPontoInteresse {
  id        String   @id @default(uuid())
  nome      String   @unique
  cor       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pontos EdicaoPontoInteresse[]

  @@map("tipos_ponto_interesse")
}

// Pontos plotados no mapa da dobra "Localização" da página pública —
// local do evento, hospedagens, restaurantes etc. indicados pelo gestor.
// Coordenadas são coladas manualmente (sem geocodificação automática).
model EdicaoPontoInteresse {
  id        String             @id @default(uuid())
  edicaoId  String
  edicao    Edicao             @relation(fields: [edicaoId], references: [id], onDelete: Cascade)
  tipoId    String
  tipo      TipoPontoInteresse @relation(fields: [tipoId], references: [id])
  nome      String
  imagem    String?
  endereco  String?
  latitude  Float
  longitude Float
  link      String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@map("edicao_pontos_interesse")
}

// Modalidade de submissão de trabalhos (ex. "Conversatórios", "Narrativas
// Multimodais de Experiências") — por edição, cadastrada pelo gestor em
// Submissões → Modalidades. Substitui o catálogo antes fixo em
// frontend/lib/modalidadesSubmissao.js.
model ModalidadeSubmissao {
  id             String   @id @default(uuid())
  edicaoId       String
  edicao         Edicao   @relation(fields: [edicaoId], references: [id], onDelete: Cascade)
  slug           String
  nome           String
  subtitulo      String?
  prazoInicio    DateTime
  prazoFim       DateTime
  resumoCurto    String
  perguntaTitulo String
  descricao      String?
  linkRotulo     String   @default("Saiba mais")
  // Rótulo usado nas áreas desta modalidade, ex. "Conversatório" — a área N
  // é exibida publicamente como "{rotuloItem} N" (N deriva de AreaSubmissao.ordem).
  rotuloItem     String   @default("Área")
  ordem          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  areas      AreaSubmissao[]
  submissoes Submissao[]

  @@unique([edicaoId, slug])
  @@map("modalidades_submissao")
}

// Área temática dentro de uma modalidade (ex. os 15 Conversatórios de hoje)
// — nem toda modalidade tem áreas (lista pode ficar vazia).
model AreaSubmissao {
  id                    String              @id @default(uuid())
  modalidadeSubmissaoId String
  modalidadeSubmissao   ModalidadeSubmissao @relation(fields: [modalidadeSubmissaoId], references: [id], onDelete: Cascade)
  slug                  String
  titulo                String
  descricao             String?
  ordem                 Int                 @default(0)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  submissoes            Submissao[]
  atividades            Atividade[]
  avaliadores           AvaliadorEdicao[]
  sugestoesComoAtual    SugestaoTrocaArea[] @relation("SugestaoAreaAtual")
  sugestoesComoSugerida SugestaoTrocaArea[] @relation("SugestaoAreaSugerida")

  @@unique([modalidadeSubmissaoId, slug])
  @@map("areas_submissao")
}

// Trabalho submetido por um participante numa modalidade/área de submissão.
// Quem submete (usuarioId, identificado via fluxo passwordless por e-mail em
// submissoes.service.js) é sempre o autor principal — nunca escolhido pelo
// client, ver SubmissaoAutor.principal.
model Submissao {
  id                           String                @id @default(uuid())
  edicaoId                     String
  edicao                       Edicao                @relation(fields: [edicaoId], references: [id], onDelete: Cascade)
  modalidadeSubmissaoId        String
  modalidadeSubmissao          ModalidadeSubmissao   @relation(fields: [modalidadeSubmissaoId], references: [id])
  areaSubmissaoId              String?
  areaSubmissao                AreaSubmissao?        @relation(fields: [areaSubmissaoId], references: [id])
  titulo                       String
  // HTML sanitizado (ver sanitizarResumoSubmissao.js) — imagens embutidas já
  // trocadas de data URI por URL do GCS antes de salvar.
  resumo                       String                @db.Text
  // HTML sanitizado (ver sanitizarReferenciaBibliografica.js) — só permite
  // <strong>, sem link/itálico/imagem.
  referenciaBibliografica      String                @db.Text
  usuarioId                    String
  usuario                      Usuario               @relation(fields: [usuarioId], references: [id])
  autores                      SubmissaoAutor[]
  // Decisão consolidada pela organização depois de ver as decisões dos
  // avaliadores (AtribuicaoAvaliacao.decisao) — travada a partir daqui, o
  // avaliador não altera mais a própria decisão.
  decisaoFinal                 DecisaoAvaliacao?
  decisaoFinalEm               DateTime?
  decisaoFinalPorId            String?
  atribuicoesAvaliacao         AtribuicaoAvaliacao[]
  sugestoesTrocaArea           SugestaoTrocaArea[]
  // Resultado: observação da organização enviada junto com a decisão, e o
  // fluxo de correção pedido ao autor principal (só ressalvas/formatação).
  observacaoResultado          String?               @db.Text
  statusCorrecao               StatusCorrecao?
  correcaoEnviadaEm            DateTime?
  motivoDevolucao              String?               @db.Text
  emailResultadoEnviadoEm      DateTime?
  emailResultadoErro           String?
  versoes                      SubmissaoVersao[]
  // Apresentação: uma atividade por trabalho aprovado, com ordem dentro
  // dela. emailApresentacaoAtividadeId = atividade sobre a qual os autores
  // foram avisados; diferente da atual = aviso pendente (trabalho novo ou
  // que mudou de atividade).
  atividadeApresentacaoId      String?
  atividadeApresentacao        Atividade?            @relation(fields: [atividadeApresentacaoId], references: [id], onDelete: Restrict)
  ordemApresentacao            Int?
  emailApresentacaoAtividadeId String?
  emailApresentacaoEnviadoEm   DateTime?
  emailApresentacaoErro        String?
  // Página própria do trabalho nos Anais (slug, contadores, páginas no PDF)
  // — criada por anais.service.js quando a submissão entra no critério.
  artigoAnais                  ArtigoAnais?
  createdAt                    DateTime              @default(now())
  updatedAt                    DateTime              @updatedAt

  @@index([atividadeApresentacaoId])
  @@map("submissoes")
}

enum DecisaoAvaliacao {
  APROVADO
  APROVADO_COM_RESSALVAS
  // Aprovado, mas o autor principal precisa revisar a formatação do resumo e
  // da referência antes da publicação (caso típico: importados do Even3).
  APROVADO_FORMATACAO
  REPROVADO
}

// PENDENTE = aguardando o autor; ENVIADA = correção com ressalvas aguardando
// conferência da organização; DEVOLVIDA = organização pediu nova correção;
// CONCLUIDA = pronta para publicação (formatação conclui direto ao salvar).
enum StatusCorrecao {
  PENDENTE
  ENVIADA
  DEVOLVIDA
  CONCLUIDA
}

enum OrigemVersao {
  CORRECAO_AUTOR
  ORGANIZACAO
}

// Cópia do texto de uma submissão antes de uma alteração: cada correção do
// autor (comparada lado a lado no Resultado) ou, no máximo a cada 30 min,
// uma sessão de edição da organização no editor (autosave).
model SubmissaoVersao {
  id                      String       @id @default(uuid())
  submissaoId             String
  submissao               Submissao    @relation(fields: [submissaoId], references: [id], onDelete: Cascade)
  titulo                  String
  resumo                  String       @db.Text
  referenciaBibliografica String       @db.Text
  origem                  OrigemVersao @default(CORRECAO_AUTOR)
  editadoPorId            String?
  createdAt               DateTime     @default(now())

  @@index([submissaoId])
  @@map("submissao_versoes")
}

// Texto-padrão do e-mail de resultado, um por decisão e por edição — sem
// registro, vale o texto-padrão de emailResultado.service.js.
model ModeloEmailResultado {
  id        String           @id @default(uuid())
  edicaoId  String
  edicao    Edicao           @relation(fields: [edicaoId], references: [id], onDelete: Cascade)
  decisao   DecisaoAvaliacao
  assunto   String
  corpo     String           @db.Text
  updatedAt DateTime         @updatedAt

  @@unique([edicaoId, decisao])
  @@map("modelos_email_resultado")
}

// AREA = criada automaticamente pelo vínculo avaliador↔área (ver
// avaliacoes.service.js); MANUAL = atribuída pela organização direto na
// submissão. Só as AREA sem decisão somem quando o avaliador perde a área.
enum OrigemAtribuicao {
  AREA
  MANUAL
}

enum StatusSugestaoArea {
  PENDENTE
  APROVADA
  RECUSADA
}

// Avaliador de submissões numa edição (externo ou da organização). A
// distribuição é materializada em AtribuicaoAvaliacao — as áreas aqui só
// disparam a criação das atribuições, não são consultadas em tempo real.
model AvaliadorEdicao {
  id          String                @id @default(uuid())
  edicaoId    String
  edicao      Edicao                @relation(fields: [edicaoId], references: [id], onDelete: Cascade)
  usuarioId   String
  usuario     Usuario               @relation(fields: [usuarioId], references: [id])
  areas       AreaSubmissao[]
  atribuicoes AtribuicaoAvaliacao[]
  sugestoes   SugestaoTrocaArea[]
  createdAt   DateTime              @default(now())

  @@unique([edicaoId, usuarioId])
  @@map("avaliadores_edicao")
}

model AtribuicaoAvaliacao {
  id                String            @id @default(uuid())
  submissaoId       String
  submissao         Submissao         @relation(fields: [submissaoId], references: [id], onDelete: Cascade)
  avaliadorEdicaoId String
  avaliadorEdicao   AvaliadorEdicao   @relation(fields: [avaliadorEdicaoId], references: [id], onDelete: Cascade)
  origem            OrigemAtribuicao
  decisao           DecisaoAvaliacao?
  decididoEm        DateTime?
  createdAt         DateTime          @default(now())

  @@unique([submissaoId, avaliadorEdicaoId])
  @@index([avaliadorEdicaoId])
  @@map("atribuicoes_avaliacao")
}

// Avaliador pode, em vez de avaliar, sugerir que a submissão está na área
// errada. Aprovada pela organização, a submissão muda de área e é
// redistribuída do zero para os avaliadores da nova área.
model SugestaoTrocaArea {
  id                String             @id @default(uuid())
  submissaoId       String
  submissao         Submissao          @relation(fields: [submissaoId], references: [id], onDelete: Cascade)
  avaliadorEdicaoId String
  avaliadorEdicao   AvaliadorEdicao    @relation(fields: [avaliadorEdicaoId], references: [id], onDelete: Cascade)
  areaAtualId       String?
  areaAtual         AreaSubmissao?     @relation("SugestaoAreaAtual", fields: [areaAtualId], references: [id], onDelete: SetNull)
  areaSugeridaId    String
  areaSugerida      AreaSubmissao      @relation("SugestaoAreaSugerida", fields: [areaSugeridaId], references: [id], onDelete: Cascade)
  justificativa     String?
  status            StatusSugestaoArea @default(PENDENTE)
  resolvidoPorId    String?
  resolvidoEm       DateTime?
  createdAt         DateTime           @default(now())

  @@index([submissaoId])
  @@map("sugestoes_troca_area")
}

// Autor/coautor de uma submissão. nome/email/orcid são sempre guardados aqui
// (denormalizados), mesmo quando a pessoa tem conta — usuarioId só existe
// quando o e-mail bate com um Usuario (na hora de adicionar, ou associado
// retroativamente se essa pessoa se cadastrar depois, ver
// usuarios.service.js).
// Convite de cadastro para coautor sem conta — um por e-mail (minúsculo),
// compartilhado entre todas as autorias soltas com esse e-mail. Não usa
// TokenVerificacao porque ele exige usuarioId e o coautor ainda não tem conta.
// O token vai no link /cadastro?convite=: abrir o link prova a posse do
// e-mail, então a conta nasce confirmada (ou, com "Já tenho conta", as
// autorias vão para a conta logada). Reenvio estende expiraEm e mantém o
// token, para links de e-mails anteriores continuarem valendo.
// Ver services/convitesCoautor.service.js.
model ConviteCoautor {
  id        String    @id @default(uuid())
  email     String    @unique
  token     String    @unique
  expiraEm  DateTime
  enviadoEm DateTime?
  erroEnvio String?
  usadoEm   DateTime?
  // Conta criada ou vinculada ao aceitar.
  usuarioId String?
  usuario   Usuario?  @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("convites_coautor")
}

model SubmissaoAutor {
  id          String    @id @default(uuid())
  submissaoId String
  submissao   Submissao @relation(fields: [submissaoId], references: [id], onDelete: Cascade)
  nome        String
  email       String
  orcid       String?
  usuarioId   String?
  usuario     Usuario?  @relation(fields: [usuarioId], references: [id])
  principal   Boolean   @default(false)
  ordem       Int       @default(0)
  createdAt   DateTime  @default(now())

  certificados Certificado[]

  @@index([usuarioId])
  @@map("submissao_autores")
}

// Layout de um tipo de certificado numa edição. Sem registro, vale o modelo
// padrão de certificados.service.js. Medidas em mm sobre a página A4 paisagem
// (297 × 210); tamanhoFonte em pt. imagemFundo é a URL pública no GCS
// (normalizada pra JPEG no upload) — o mesmo arquivo pode ser compartilhado
// por vários tipos ("Copiar layout"), então só sai do bucket quando nenhum
// modelo usa mais. liberadoEm nulo = participantes ainda não veem nem baixam
// os certificados desse tipo.
model ModeloCertificado {
  id                  String                         @id @default(uuid())
  edicaoId            String
  edicao              Edicao                         @relation(fields: [edicaoId], references: [id], onDelete: Cascade)
  tipo                TipoCertificado
  imagemFundo         String?
  larguraFundo        Int?
  alturaFundo         Int?
  texto               String                         @db.Text
  margemSuperior      Float
  margemInferior      Float
  margemEsquerda      Float
  margemDireita       Float
  alinhamento         AlinhamentoCertificado         @default(CENTRO)
  alinhamentoVertical AlinhamentoVerticalCertificado @default(CENTRO)
  fonte               FonteCertificado               @default(ARCHIVO)
  tamanhoFonte        Float                          @default(16)
  entrelinha          Float                          @default(1.4)
  corTexto            String                         @default("#2B2622")
  posicaoQr           PosicaoQrCertificado           @default(INFERIOR_DIREITO)
  tamanhoQr           Float                          @default(24)
  margemQr            Float                          @default(12)
  // Sobrescreve a carga horária natural do tipo (edição, atividade…) — ex.
  // as 60 h da monitoria, que não vêm de nenhum outro lugar.
  cargaHoraria        Int?
  liberadoEm          DateTime?
  updatedAt           DateTime                       @updatedAt

  @@unique([edicaoId, tipo])
  @@map("modelos_certificado")
}

// Certificado emitido. chave identifica "o mesmo certificado" entre uma
// geração e outra (u:<usuario>, u:<usuario>:a:<atividade> ou sa:<autoria>),
// pra "Gerar" de novo só criar os que faltam e atualizar o snapshot dos
// existentes — o código nunca muda. dados é o snapshot dos marcadores (nome,
// atividade, carga…), usado no PDF e na validação pública mesmo que a
// presença/atividade mude depois. usuarioId é nulo para coautor sem conta (a
// conta é resolvida pela autoria quando a pessoa se cadastrar).
model Certificado {
  id               String            @id @default(uuid())
  edicaoId         String
  edicao           Edicao            @relation(fields: [edicaoId], references: [id], onDelete: Cascade)
  tipo             TipoCertificado
  chave            String
  codigo           String            @unique
  usuarioId        String?
  usuario          Usuario?          @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  submissaoAutorId String?
  submissaoAutor   SubmissaoAutor?   @relation(fields: [submissaoAutorId], references: [id], onDelete: SetNull)
  atividadeId      String?
  atividade        Atividade?        @relation(fields: [atividadeId], references: [id], onDelete: SetNull)
  origem           OrigemCertificado @default(REGRA)
  dados            Json
  revogadoEm       DateTime?
  motivoRevogacao  String?
  emitidoEm        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([edicaoId, tipo, chave])
  @@index([usuarioId])
  @@index([submissaoAutorId])
  @@map("certificados")
}

enum StatusInscricaoAtividade {
  CONFIRMADA
  LISTA_ESPERA
}

// Inscrição geral no evento (edição) — independente de haver ou não
// atividades específicas com inscrição obrigatória. Uma por usuário por
// edição; o fluxo público de auto-inscrição cria uma única vez, mas permite
// voltar depois (reidentificação por CPF+e-mail) para adicionar inscrições
// em novas atividades — editar/cancelar a inscrição geral em si continua
// exigindo login (fora do escopo atual).
model InscricaoEdicao {
  id                    String                @id @default(uuid())
  usuarioId             String
  usuario               Usuario               @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  edicaoId              String
  edicao                Edicao                @relation(fields: [edicaoId], references: [id], onDelete: Cascade)
  createdAt             DateTime              @default(now())
  // Acessibilidade, respondida pelo participante ao se inscrever (e editável
  // depois). null = sem resposta: inscrição feita pelo admin ou antes da
  // pergunta existir. adaptacoesNecessarias só vem preenchido quando
  // precisaAdaptacao = true.
  precisaAdaptacao      Boolean?
  adaptacoesNecessarias String?
  // Credenciamento geral (uma vez no evento): pelo QR code geral, pela
  // presença numa atividade ou pela equipe. credenciadoPorId só com EQUIPE.
  credenciadoEm         DateTime?
  credenciamentoOrigem  OrigemCredenciamento?
  credenciadoPorId      String?
  credenciadoPor        Usuario?              @relation("CredenciadoPor", fields: [credenciadoPorId], references: [id], onDelete: SetNull)

  @@unique([usuarioId, edicaoId])
  @@map("inscricoes_edicao")
}

// Candidatura à monitoria voluntária de uma edição (uma por pessoa por
// edição). Nome, CPF/documento e e-mail vêm da conta. funcoes guarda os
// rótulos escolhidos entre Edicao.funcoesMonitoria (cópia, pra não mudar se
// o catálogo for editado depois). autorizacaoResponsavel é o caminho no
// bucket PRIVADO (só para menor de 18 na data de início do evento), lido por
// URL assinada. observacaoCoordenacao é interna e nunca vai ao candidato.
// emailResultado*: progresso do envio do resultado (mesmo molde de
// Submissao.emailResultado*); mudar o status depois da divulgação zera o
// enviadoEm, e o aviso volta a ficar pendente.
model InscricaoMonitoria {
  id                      String                   @id @default(uuid())
  usuarioId               String
  usuario                 Usuario                  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  edicaoId                String
  edicao                  Edicao                   @relation(fields: [edicaoId], references: [id], onDelete: Cascade)
  dataNascimento          DateTime                 @db.Date
  pronome                 String
  telefone                String
  cursoInstituicao        String
  experienciaAnterior     Boolean
  funcoes                 String[]
  precisaAdaptacao        Boolean
  adaptacoesNecessarias   String?
  cienteEm                DateTime
  autorizacaoResponsavel  String?
  status                  StatusInscricaoMonitoria @default(EM_ANALISE)
  posicaoListaEspera      Int?
  observacaoCoordenacao   String?
  emailResultadoEnviadoEm DateTime?
  emailResultadoErro      String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  @@unique([usuarioId, edicaoId])
  @@index([edicaoId, status])
  @@map("inscricoes_monitoria")
}

model InscricaoAtividade {
  id                      String                   @id @default(uuid())
  usuarioId               String
  usuario                 Usuario                  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  atividadeId             String
  atividade               Atividade                @relation(fields: [atividadeId], references: [id], onDelete: Cascade)
  status                  StatusInscricaoAtividade
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  // Presença na atividade (credenciamento.service.js). Pelo QR, só para
  // CONFIRMADA; a equipe valida de qualquer um, inclusive da lista de espera
  // (o status não muda). presencaRegistradaPorId só com EQUIPE.
  presencaEm              DateTime?
  presencaOrigem          OrigemCredenciamento?
  presencaRegistradaPorId String?
  presencaRegistradaPor   Usuario?                 @relation("PresencaRegistradaPor", fields: [presencaRegistradaPorId], references: [id], onDelete: SetNull)

  // Cancelamento (self-service ou admin) promove automaticamente o próximo
  // da lista de espera — ver promoverAoCancelar em inscricoes.service.js.
  @@unique([usuarioId, atividadeId])
  @@index([atividadeId, status])
  @@map("inscricoes_atividade")
}

// ---------------------------------------------------------------------------
// Anais (módulo 11)
// ---------------------------------------------------------------------------

enum LicencaAnais {
  CC_BY
  CC_BY_SA
  CC_BY_NC
  CC_BY_NC_SA
  CC_BY_ND
  CC_BY_NC_ND
  TODOS_DIREITOS_RESERVADOS
}

// Dados da publicação dos Anais de uma edição (1:1). Sem registro = Anais
// ainda não configurados. publicadoEm nulo = páginas públicas fora do ar.
// apresentacao é rich text (sanitizarApresentacaoAnais.js, mesma allowlist
// do edital da monitoria); fichaCatalografica é texto puro, com quebras de
// linha preservadas. gruposConteudoIds = grupos de "Comissões e Programas"
// (GrupoConteudo) listados no expediente do PDF/Word. Os campos de arquivo
// guardam a última geração em segundo plano (geracaoAnais.service.js):
// geracaoIniciadaEm preenchido = gerando agora.
model AnaisEdicao {
  id                 String       @id @default(uuid())
  edicaoId           String       @unique
  edicao             Edicao       @relation(fields: [edicaoId], references: [id], onDelete: Cascade)
  titulo             String
  subtitulo          String?
  // Nome do evento sem o número da edição, como entra na referência ABNT
  // ("In: NOME DO EVENTO, 5., 2026, Brasília").
  nomeEvento         String?
  issn               String?
  isbn               String?
  editora            String?
  localPublicacao    String?
  anoPublicacao      Int?
  organizadores      String[]     @default([])
  licenca            LicencaAnais @default(CC_BY)
  apresentacao       String?      @db.Text
  fichaCatalografica String?      @db.Text
  gruposConteudoIds  String[]     @default([])
  publicadoEm        DateTime?
  pdfUrl             String?
  pdfGeradoEm        DateTime?
  docxUrl            String?
  docxGeradoEm       DateTime?
  geracaoFormato     String?
  geracaoIniciadaEm  DateTime?
  erroGeracao        String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@map("anais_edicao")
}

// Um trabalho publicado nos Anais. Materializado para toda submissão que
// entra no critério (utils/criterioAnais.js) — o slug fica fixo depois de
// criado, mesmo que o título mude. Se a submissão sair do critério o
// registro fica (contadores e comentários preservados), mas some das
// consultas públicas. paginaInicial/paginaFinal vêm da última geração do PDF
// completo.
model ArtigoAnais {
  id            String            @id @default(uuid())
  edicaoId      String
  edicao        Edicao            @relation(fields: [edicaoId], references: [id], onDelete: Cascade)
  submissaoId   String            @unique
  submissao     Submissao         @relation(fields: [submissaoId], references: [id], onDelete: Cascade)
  slug          String
  ocultoEm      DateTime?
  paginaInicial Int?
  paginaFinal   Int?
  visualizacoes Int               @default(0)
  downloads     Int               @default(0)
  comentarios   ComentarioAnais[]
  createdAt     DateTime          @default(now())

  @@unique([edicaoId, slug])
  @@map("artigos_anais")
}

// Comentário público num artigo dos Anais — só de quem tem conta, aparece
// na hora; a organização oculta (ocultoEm) ou exclui. respostaAId aponta
// sempre para um comentário raiz (um nível de resposta só).
model ComentarioAnais {
  id            String            @id @default(uuid())
  artigoAnaisId String
  artigoAnais   ArtigoAnais       @relation(fields: [artigoAnaisId], references: [id], onDelete: Cascade)
  usuarioId     String
  usuario       Usuario           @relation(fields: [usuarioId], references: [id])
  respostaAId   String?
  respostaA     ComentarioAnais?  @relation("RespostasComentarioAnais", fields: [respostaAId], references: [id], onDelete: Cascade)
  respostas     ComentarioAnais[] @relation("RespostasComentarioAnais")
  texto         String            @db.Text
  ocultoEm      DateTime?
  ocultoPorId   String?
  createdAt     DateTime          @default(now())

  @@index([artigoAnaisId, createdAt])
  @@map("comentarios_anais")
}

// E-mails em massa (emailsMassa.service.js) — só ADMIN. Modelo é global
// (vale para todas as edições); {{edicao}} vem da edição de onde parte o
// envio. Corpo em HTML sanitizado com a allowlist de
// sanitizarCorpoContribuicao, com {{marcadores}} de utils/marcadoresEmailMassa.js.
model ModeloEmail {
  id        String       @id @default(uuid())
  // Rótulo interno, só para achar o modelo na lista.
  nome      String
  assunto   String
  corpo     String       @db.Text
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  envios    EnvioEmail[]

  @@map("modelos_email")
}

// Um envio em massa, com cópia do texto (o modelo pode mudar ou sumir
// depois). Destinatários sem enviadoEm estão pendentes — "Retomar" reenfileira
// os pendentes e os com erro (pausa por limite do Resend, restart no meio).
model EnvioEmail {
  id            String                   @id @default(uuid())
  edicaoId      String?
  edicao        Edicao?                  @relation(fields: [edicaoId], references: [id], onDelete: SetNull)
  modeloId      String?
  modelo        ModeloEmail?             @relation(fields: [modeloId], references: [id], onDelete: SetNull)
  assunto       String
  corpo         String                   @db.Text
  criadoPorId   String?
  criadoPor     Usuario?                 @relation("EnvioEmailCriadoPor", fields: [criadoPorId], references: [id], onDelete: SetNull)
  concluidoEm   DateTime?
  createdAt     DateTime                 @default(now())
  destinatarios EnvioEmailDestinatario[]

  @@index([edicaoId])
  @@map("envios_email")
}

// Nome/e-mail copiados no momento do envio (a anonimização da conta troca
// os dois, ver usuarios.service.js operacoesAnonimizacao).
model EnvioEmailDestinatario {
  id        String     @id @default(uuid())
  envioId   String
  envio     EnvioEmail @relation(fields: [envioId], references: [id], onDelete: Cascade)
  usuarioId String?
  usuario   Usuario?   @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  nome      String
  email     String
  enviadoEm DateTime?
  erro      String?

  @@index([envioId])
  @@index([usuarioId])
  @@index([enviadoEm])
  @@map("envios_email_destinatarios")
}

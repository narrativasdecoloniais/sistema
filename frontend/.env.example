NEXT_PUBLIC_API_URL=http://localhost:4000
# Maps JavaScript API habilitada no mesmo projeto GCP do GCS_PROJECT_ID
# (backend/.env.example) — chave restrita por referrer HTTP no Google Cloud Console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Endereço público do site (sem barra no fim) — usado em links canônicos,
# Open Graph, sitemap.xml/robots.txt e nas páginas dos Anais.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
